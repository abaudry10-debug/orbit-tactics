{
  "name": "orbit-tactics",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "setup": "npm install && npx expo install --fix",
    "start": "expo start",
    "tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --import ./tests/register.mjs --test tests/*.test.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "*",
    "expo": "latest",
    "expo-status-bar": "*",
    "react": "*",
    "react-dom": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*",
    "react-native-web": "*"
  },
  "devDependencies": {
    "@types/react": "*",
    "typescript": "*"
  }
}
